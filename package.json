{
  "name": "speakcoach",
  "version": "1.0.10",
  "private": true,
  "description": "SpeakCoach — English Shadowing and IELTS Speaking Practice",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build && npx cap sync android",
    "audit:production": "npm audit --omit=dev --audit-level=high --json",
    "postinstall": "node scripts/patch-capacitor-cli-tar.js",
    "check:android-compat": "node scripts/check-android-compatibility.mjs"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^5.0.0",
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/network": "^6.0.1",
    "@capacitor/preferences": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "tar": "^7.5.21",
    "glob": "^14.0.2"
  }
}
